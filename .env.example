# Required. Shared PIN for the /admin content editor. Without this set, /admin
# cannot verify logins and will throw when a login is attempted.
ADMIN_PIN=

# Optional. Both required together to enable Upstash Redis for saved content.
# Leave unset for local dev — content falls back to the local
# data/site-content.json file, created automatically on first save.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional. Enables Vercel Blob for image/video uploads (needed in production,
# since Vercel has no persistent filesystem). Leave unset for local dev —
# uploads fall back to writing into public/uploads/.
BLOB_READ_WRITE_TOKEN=
